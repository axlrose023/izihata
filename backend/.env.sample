# Environment
APP__ENV=local
# Optional complete DSN override, useful for ephemeral environments and tests.
# APP__DATABASE_URL_OVERRIDE=sqlite+aiosqlite:///./izihata.db

# API Configuration
APP__API__PORT=8000
APP__API__ALLOWED_ORIGINS=["http://localhost:3000"]
APP__API__ALLOWED_HOSTS=["localhost","127.0.0.1"]
APP__API__FORWARDED_ALLOW_IPS=["127.0.0.1"]

# JWT Configuration
APP__JWT__SECRET_KEY=your-secret-key-here
APP__JWT__ALGORITHM=HS256
APP__JWT__ACCESS_TOKEN_EXPIRES_IN_MINUTES=30
APP__JWT__REFRESH_EXPIRES_IN_MINUTES=1440

# PostgreSQL Configuration
APP__POSTGRES__USER=postgres
APP__POSTGRES__PASSWORD=postgres
APP__POSTGRES__HOST=localhost
APP__POSTGRES__PORT=5432
APP__POSTGRES__DB=izihata
APP__POSTGRES__POOL_SIZE=10
APP__POSTGRES__MAX_OVERFLOW=20
APP__POSTGRES__POOL_TIMEOUT_SECONDS=30
APP__POSTGRES__POOL_RECYCLE_SECONDS=1800
APP__POSTGRES__STATEMENT_TIMEOUT_MS=15000

# Redis Configuration
APP__REDIS__HOST=localhost
APP__REDIS__PORT=6379
APP__REDIS__DB=0

# Public write endpoint rate limiting
APP__RATE_LIMIT__ENABLED=true
APP__RATE_LIMIT__FAIL_OPEN=false

# Nova Poshta address directory. Public address methods currently accept an
# empty key; set your business API key for a supported production integration.
APP__NOVA_POSHTA__API_URL=https://api.novaposhta.ua/v2.0/json/
# APP__NOVA_POSHTA__API_KEY=your-api-key
APP__NOVA_POSHTA__TIMEOUT_SECONDS=5

# Outbox worker bounds
APP__OUTBOX__BATCH_SIZE=10
APP__OUTBOX__LEASE_SECONDS=300
APP__OUTBOX__DISPATCH_TIMEOUT_SECONDS=15
APP__OUTBOX__MAX_ATTEMPTS=8
APP__OUTBOX__RETENTION_DAYS=30
