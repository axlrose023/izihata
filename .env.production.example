# This file is a template only. Copy it to .env.production on the server and
# replace every value marked <...>. Never commit the completed file.
ACME_EMAIL=<operations-email>

APP__API__PORT=8000
APP__JWT__SECRET_KEY=<at-least-32-random-characters>

APP__POSTGRES__USER=izihata
APP__POSTGRES__PASSWORD=<long-random-password>
APP__POSTGRES__DB=izihata

APP__RATE_LIMIT__ENABLED=true
APP__RATE_LIMIT__FAIL_OPEN=false

