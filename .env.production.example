# This file is a template only. Copy it to .env.production on the server and
# replace every value marked <...>. Never commit the completed file.
ACME_EMAIL=<operations-email>

APP__API__PORT=8000
APP__JWT__SECRET_KEY=<at-least-32-random-characters>

APP__POSTGRES__USER=izihata
APP__POSTGRES__PASSWORD=<long-random-password>
APP__POSTGRES__DB=izihata

APP__RATE_LIMIT__ENABLED=true
APP__RATE_LIMIT__FAIL_OPEN=false

# Optional: enables live Nova Poshta city and branch search.
# APP__NOVA_POSHTA__API_KEY=<nova-poshta-api-key>

# Optional: enables the WayForPay card widget and signed payment callbacks.
# Configure all three values together after the merchant account is activated.
# APP__WAYFORPAY__MERCHANT_ACCOUNT=<wayforpay-merchant-account>
# APP__WAYFORPAY__MERCHANT_DOMAIN_NAME=izihata.com.ua
# APP__WAYFORPAY__SECRET_KEY=<wayforpay-secret-key>
# APP__WAYFORPAY__TEST_MODE=false

# Used only by the explicit ETI catalogue import command.
# BUNNY_S3_ENDPOINT=https://de-s3.storage.bunnycdn.com
# BUNNY_STORAGE_ZONE=izihata-product-media
# BUNNY_STORAGE_PASSWORD=<storage-zone-write-password>
# BUNNY_MEDIA_PUBLIC_BASE_URL=https://<pull-zone>.b-cdn.net
